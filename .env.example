NODE_ENV=development
PORT=3000

# OpenAI (primary historical-analysis provider) — https://platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini (secondary / cross-check) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Only needed as a local Windows dev workaround — see DOCUMENTATION.md. Leave unset in Docker/Linux.
CHROMIUM_EXECUTABLE_PATH=

# Scrape cache — stale-while-revalidate (see DOCUMENTATION.md and src/scraper/cache.ts).
# Fresh window: served instantly, no background work. Default 1 hour.
SCRAPE_CACHE_TTL_MS=3600000
# Stale window (on top of the fresh one): still served instantly, but triggers
# a background re-scrape for the next request. Default 24 hours.
SCRAPE_STALE_CACHE_TTL_MS=86400000
# Max scrapes running at once on the shared browser — past this, requests
# queue instead of piling unbounded load onto one browser process.
SCRAPE_MAX_CONCURRENCY=6

# MongoDB (festival/event calendar store) — https://cloud.mongodb.com
MONGODB_URI=
MONGODB_DB_NAME=izhinga

# Google Weather API (auto-detects `weather` from the POI's real coordinates
# when the caller omits it — see src/weather/autoDetectWeather.ts). Optional:
# leave unset and `weather` just stays caller-supplied-only, same as before.
GOOGLE_WEATHER_API_KEY=

# API authentication (see src/auth/) — REQUIRED, every real endpoint (except
# /health and /api/auth/*) will reject every request without these set.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Deliberately two DIFFERENT secrets, not one shared between access/refresh.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=1d
JWT_REFRESH_TTL=7d
