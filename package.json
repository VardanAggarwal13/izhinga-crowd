{
  "name": "izhinga-crowd-api",
  "version": "0.1.0",
  "description": "iZhinga Crowd Intelligence API — Google Maps popular-times scraper + category crowd-calibration engine + dual-AI historical analysis (OpenAI primary + Gemini secondary)",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "playwright:install": "playwright install --with-deps chromium",
    "seed:calendar": "tsx src/db/seedCalendar.ts",
    "seed:anchors": "tsx src/db/seedPoiAnchors.ts",
    "create:client": "tsx src/db/createApiClient.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.6.0",
    "openai": "^4.73.0",
    "playwright": "^1.48.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
